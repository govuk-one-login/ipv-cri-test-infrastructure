{
    "name": "ipv-cri-test-infrastructure",
    "type": "module",
    "workspaces": [
        "headless-journey-script"
    ],
    "scripts": {
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --check --ignore-unknown",
        "format:fix": "prettier --write --ignore-unknown",
        "sam:build": "npm run sam:validate && sam build --template ../infrastructure/template.yaml --cached --parallel",
        "sam:validate": "cd ../infrastructure && sam validate && sam validate --lint",
        "test": "npm run unit --",
        "test:integration": "vitest run --config ./vitest.config.integration.ts --no-file-parallelism",
        "test:coverage": "npm run unit -- --coverage",
        "unit": "POWERTOOLS_LOG_LEVEL=SILENT vitest run --exclude '../integration-tests/**'",
        "unit:logs": "vitest run",
        "ui:dev": "node headless-core-stub/lambdas/ui/dev.mjs"
    },
    "dependencies": {
        "@aws-lambda-powertools/commons": "2.33.0",
        "@aws-lambda-powertools/logger": "2.33.0",
        "@aws-lambda-powertools/parameters": "2.33.0",
        "@aws-sdk/client-cloudformation": "3.1048.0",
        "@aws-sdk/client-dynamodb": "3.1048.0",
        "@aws-sdk/client-kms": "3.1048.0",
        "@aws-sdk/client-lambda": "3.1048.0",
        "@aws-sdk/client-sns": "3.1048.0",
        "@aws-sdk/client-ssm": "3.1048.0",
        "@aws-sdk/credential-providers": "3.1048.0",
        "@codegenie/serverless-express": "5.0.0",
        "@govuk-one-login/data-vocab": "2.0.2",
        "@govuk-one-login/data-vocab-schemas": "2.0.2",
        "@middy/core": "4.7.0",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "aws-sdk-client-mock": "4.1.0",
        "ecdsa-sig-formatter": "1.0.11",
        "esbuild": "0.28.1",
        "express": "5.3.0",
        "govuk-frontend": "6.6.0",
        "jose": "6.2.3",
        "nunjucks": "3.2.4"
    },
    "devDependencies": {
        "@aws-sdk/types": "3.973.8",
        "@eslint/js": "^10.0.1",
        "@types/aws-lambda": "^8.10.161",
        "@types/express": "^5.0.6",
        "@types/nunjucks": "^3.2.6",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^4.1.12",
        "aws-sigv4-fetch": "4.4.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "supertest": "^7.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.3",
        "vitest": "4.1.12"
    }
}
